# ============================================================
# Environment Variables — copy this to .env and fill in values
# ============================================================

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_api_key_here
# Tavily Search API Key (get from https://tavily.com)
# Used by the Research Agent to search the web

#TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API Key (optional alternative to OpenAI)
# GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model to use (default: gpt-4o-mini for cost efficiency)
LLM_MODEL=gpt-4o-mini

# Search provider: "tavily" or "duckduckgo" (duckduckgo needs no API key)
SEARCH_PROVIDER=duckduckgo
